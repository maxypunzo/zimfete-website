# Copy to /opt/zimfete-assets/zimfete-assets.env, then: chmod 600 zimfete-assets.env
# Database: a separate database on the same MariaDB server as Fineract.
DB_URL=jdbc:mariadb://localhost:3306/zimfete_assets
DB_USERNAME=zimfete_assets
DB_PASSWORD=change-me

# Fineract, reached on the same VM (no TLS needed on localhost).
FINERACT_URL=http://localhost:8080/fineract-provider/api/v1
FINERACT_TENANT=default
# A dedicated Fineract service user (NOT the default mifos/password).
FINERACT_USERNAME=asset-module
FINERACT_PASSWORD=change-me

# IDs from your Fineract installation (see README "Fineract setup").
ASSET_DEPOSIT_PRODUCT_ID=
ASSET_LOAN_PRODUCT_ID=
SUPPLIER_PAYMENT_TYPE_ID=
ASSET_LOAN_FUND_ID=

# Long random string; also used in the Fineract hook URL. e.g. openssl rand -hex 24
FINERACT_WEBHOOK_TOKEN=

PHOTO_DIR=/opt/zimfete-assets/photos
PORT=8090
